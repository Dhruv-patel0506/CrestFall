# ---------------------------------------------------------------------------
# Data that does not belong in git
# ---------------------------------------------------------------------------
# ~2 GB of source CSVs. Clone hosts get these out-of-band (see README), or the
# demo runs against a hosted engine that already has them.
scenario_intelligence_engine/new_data/

# Per-company monthly aggregates + uploaded demo companies, rebuilt at runtime.
scenario_intelligence_engine/data/uploads/

# Leftovers from the abandoned static-site experiment (the app computes live).
scenario_intelligence_engine/frontend/public/data/

# ---------------------------------------------------------------------------
# Build output & dependencies (Vercel rebuilds the frontend from source)
# ---------------------------------------------------------------------------
node_modules/
scenario_intelligence_engine/frontend/dist/
scenario_intelligence_engine/frontend/.vite/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# ---------------------------------------------------------------------------
# Local runs, scratch & OS noise
# ---------------------------------------------------------------------------
*.log
# The live quick-tunnel link changes every time the tunnel restarts - machine
# generated, never a committed value.
deploy/tunnel-url.txt
deploy/logs/
.backup/
scripts/
.DS_Store
Thumbs.db
desktop.ini

# Screen-recording / verification artifacts that live at the workspace root
# (the transition reference clip and browser screenshots are not project files)
/*.png
/*.jpg
/*.mp4

# Environment overrides (VITE_API_BASE etc.) - commit .env.example instead
.env
.env.local
.env.*.local

# ---------------------------------------------------------------------------
# Local-only artifacts (kept on disk, never committed)
# ---------------------------------------------------------------------------
# Tunnel binary and release bundles - large, rebuilt by deploy/make-release.ps1
/cloudflared.exe
/release/
*.exe
*.zip
# Sample company CSVs for trying the upload screen (~50 MB each)
/*.csv
# Windows redirect leftover and script output
/nul
*.out
# Abandoned GitHub Pages landing-page experiment; its workflow would run on every push
/site/
/.github/workflows/pages.yml
# Vercel CLI link metadata
.vercel/
