# Crestfall frontend build configuration.
# Copy this file to `.env` and adjust, then rebuild:  npm run build
#
# Where the React app finds the Python engine (main.py).
# Leave this unset for local work - the app already resolves it automatically:
#   dev server (npm run dev)   -> http://127.0.0.1:8000/api
#   production build           -> /api on the same origin
#
# Set it when the engine lives on a different host than the site, e.g.
# VITE_API_BASE=https://crestfall-engine.onrender.com/api
#
# Alternative without rebuilding - set it from the hosting page (WordPress)
# before the app bundle loads:
#   <script>window.__CRESTFALL_API__ = "https://crestfall-engine.onrender.com/api";</script>
# or per-visit for demos:  your-site.com/dashboard/?api=https://staging-engine/api
